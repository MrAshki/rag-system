# Python
__pycache__/
*.pyc
venv/

# Environment / local config
.env
.claude/

# Large downloaded model & package files (fetch separately, see README)
models/
wheels/

# Vector store data (regenerated at runtime from docs/)
chroma_persistent_storage/

# Local maintenance backups of the vector store (large, machine-specific)
backups/
tmp/
.playwright-mcp/

# Prevent accidental reintroduction of the removed legacy SQLite database.
app_data.sqlite3

# Runtime server logs
*.log
.backend.pid
.frontend.pid

# User-uploaded documents (runtime data, not source)
docs/*
!docs/.gitkeep
!docs/rag-model-selection-summary.md
!docs/rag-document-conversation-architecture.md
!docs/rag-quality-baseline.md
!docs/rag-production-path-fixes.md

# Per-user file store: originals + normalized markdown + metadata (runtime data).
# Replaces the old flat docs/ + converted/ layout; regenerated from uploads.
storage/

# Local Gold Set source PDFs and deterministic fixture PDFs.
composite_goldset_pdfs/

# Manual test inputs — copied book/test files kept local for manual UI testing
# (copyrighted source, not for distribution). Keep the folder, ignore its contents.
manual_test_inputs/*
!manual_test_inputs/.gitkeep

# Book source materials (copyrighted, not for distribution)
books/
converted/

# Local font source folder; app-bundled fonts live under apps/web/src/app/fonts/.
fonts/
