CHAT_PROVIDER=openrouter
DEFAULT_CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_APP_NAME=rag-system

# Final production RAG path. The fallback reuses the exact primary payload and
# runs once only after a technical or structured-response failure.
RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIM=2048
OPENROUTER_EMBED_BATCH_SIZE=64
OPENROUTER_EMBED_RETRY_ATTEMPTS=5
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
# Local Docker Qdrant does not need an API key. Set this only for Qdrant Cloud
# or a secured self-hosted instance.
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents
RAG_RETRIEVAL_MODE=r2
RAG_CROSS_LANGUAGE_REWRITE_ENABLED=true
RAG_PRIMARY_GENERATOR_MODEL=google/gemini-2.5-flash
RAG_FALLBACK_GENERATOR_MODEL=z-ai/glm-5.2
RAG_GENERATOR_FALLBACK_ENABLED=true
RAG_MAX_GENERATOR_ATTEMPTS=2
RAG_MAX_OUTPUT_TOKENS=900

# One bounded reranker call follows R2 lexical+dense candidate fusion.
RERANKER_PROVIDER=openrouter
RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
ENABLE_RERANKER=true
RETRIEVE_K=30
RERANK_TOP_K=5
ENABLE_HYBRID_RETRIEVAL=true
# Lexical BM25 is computed locally over at most this many scoped Qdrant payloads.
LEXICAL_SCAN_LIMIT=2000
ENABLE_LANGGRAPH_RAG=true

# Optional generic providers retained by the gateway, but not selected by the
# production grounded RAG route.
OLLAMA_MODEL=gemma3:12b
OLLAMA_NUM_CTX=8192
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MODEL=chat_free
LITELLM_CHAT_MODEL_OPTIONS=chat_free
LITELLM_MASTER_KEY=
LITELLM_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AGENTIC_SUMMARY_WINDOW_CHARS=7000
AGENTIC_SUMMARY_MAX_WINDOWS=20
AGENTIC_SUMMARY_MAX_EVIDENCE=20
AGENTIC_SUMMARY_EVIDENCE_CHARS=1200
AGENTIC_SUMMARY_EVIDENCE_PER_CHAPTER=5
AGENTIC_SUMMARY_BATCH_CHARS=32000
AGENTIC_SUMMARY_RETRY_ATTEMPTS=1
AGENTIC_SUMMARY_MAX_OUTPUT_TOKENS=2400

# Step 2.5: optional LLM-assisted structure relabeling during document
# normalization (ingest.py). Off by default -- deterministic heuristics run
# unchanged either way. The LLM only relabels structure (heading/list/etc),
# it never rewrites/regenerates the document's text.
ENABLE_TEXT_CLEANUP=true
ENABLE_LLM_NORMALIZATION=false
LLM_NORMALIZATION_PROVIDER=gemini
LLM_NORMALIZATION_MODEL=gemini-2.5-flash
LLM_NORMALIZATION_NUM_CTX=4096
LLM_NORMALIZATION_MAX_BATCHES=20

# OCR fallback for image-only or broken-text PDFs.
TESSERACT_CMD=
OCR_LANG=fas+eng
OCR_DPI=300
ENABLE_OCR_FALLBACK=true

# PostgreSQL connection. SQLAlchemy URL is preferred; legacy libpq conninfo is
# still accepted by the app during local development.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/rag_system

# Flask session signing key (required). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Public base URL the server is reached at (used for ZarinPal callback URL and
# secure-cookie decisions). Use https:// in production.
PUBLIC_BASE_URL=http://127.0.0.1:5000

# SMS / OTP provider — "console" logs the OTP code to the server log for testing.
SMS_PROVIDER=console

# ZarinPal payment gateway
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
