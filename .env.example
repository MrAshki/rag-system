OLLAMA_MODEL=gemma3:12b
CHAT_PROVIDER=litellm
CHAT_MODEL=
DEFAULT_CHAT_PROVIDER=litellm
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MODEL=chat_free
LITELLM_CHAT_MODEL_OPTIONS=chat_free
LITELLM_MASTER_KEY=sk-local-litellm-test-key
LITELLM_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
# Context window (in tokens) for the main answer-generation calls in rag.py.
# Must match (or be <=) the context length Ollama itself is configured to
# serve the model at. Falls back to 4096 if unset; fails fast if set to a
# non-positive-integer value.
OLLAMA_NUM_CTX=8192
EMBEDDING_MODEL=./models/bge-m3
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_DIM=1024
VECTOR_BACKEND=pgvector

# Two-stage retrieval: dense (bge-m3) wide net -> cross-encoder rerank -> top_k.
# Set ENABLE_RERANKER=false to fall back to plain dense top_k. The reranker runs on
# CPU by default so it doesn't compete with bge-m3 / Ollama for GPU memory.
RERANKER_MODEL=./models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
ENABLE_RERANKER=true
RETRIEVE_K=30
RERANK_TOP_K=5

# Step 2.5: optional LLM-assisted structure relabeling during document
# normalization (ingest.py). Off by default -- deterministic heuristics run
# unchanged either way. The LLM only relabels structure (heading/list/etc),
# it never rewrites/regenerates the document's text.
ENABLE_LLM_NORMALIZATION=false
LLM_NORMALIZATION_MODEL=gemma3:12b
LLM_NORMALIZATION_NUM_CTX=4096
LLM_NORMALIZATION_MAX_BATCHES=20

# Optional OCR fallback path for scanned/low-text-density PDFs (Step 2).
# Off by default. No OCR backend is installed; turning this on without one
# just records ocr_backend_available=false in metadata, nothing breaks.
ENABLE_OCR_FALLBACK=false

# PostgreSQL connection. SQLAlchemy URL is preferred; legacy libpq conninfo is
# still accepted by the app during local development.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/rag_system

# Flask session signing key (required). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Public base URL the server is reached at (used for ZarinPal callback URL and
# secure-cookie decisions). Use https:// in production.
PUBLIC_BASE_URL=http://127.0.0.1:5000

# SMS / OTP provider — "console" logs the OTP code to the server log for testing.
SMS_PROVIDER=console

# ZarinPal payment gateway
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
